{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pcsleuth",
  "version": "0.1.0",
  "identifier": "io.github.galactic717.pcsleuth",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "pcsleuth",
        "width": 1040,
        "height": 780,
        "minWidth": 360,
        "minHeight": 420,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Galactic717",
    "copyright": "Galactic717",
    "shortDescription": "Ask your Windows PC why it did that.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
